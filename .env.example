# ---------------------------------------------------------------------------
# LLM provider configuration. Business logic depends only on
# langchain_core.language_models.BaseChatModel, so the provider is swappable.
#   STOCKMIND_LLM_PROVIDER = openai | anthropic
# ---------------------------------------------------------------------------
STOCKMIND_LLM_PROVIDER=openai
STOCKMIND_LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Data provider configuration. "mock" is deterministic and needs no network.
# "yfinance" fetches real market data (Yahoo Finance; may be blocked in CN).
# "akshare" fetches real US data via Eastmoney (China-friendly, ~15min delayed).
# Real data providers require the optional dependency:
#   pip install -e ".[real-data]"
# ---------------------------------------------------------------------------
STOCKMIND_DATA_PROVIDER=mock

# ---------------------------------------------------------------------------
# Report language: en | zh
# ---------------------------------------------------------------------------
STOCKMIND_LANGUAGE=en

# ---------------------------------------------------------------------------
# Agent runtime limits
# ---------------------------------------------------------------------------
STOCKMIND_MAX_ITERATIONS=8
STOCKMIND_TOOL_TIMEOUT_SECONDS=15
STOCKMIND_TOOL_RETRIES=1
STOCKMIND_RETRY_BACKOFF_SECONDS=0.5
STOCKMIND_RETRY_MAX_BACKOFF_SECONDS=8
STOCKMIND_RETRY_JITTER=0.1

# ---------------------------------------------------------------------------
# Observability. Optional directory for JSONL trace files (leave empty for
# in-memory tracing only).
# ---------------------------------------------------------------------------
STOCKMIND_TRACE_DIR=

# Optional default ticker list for examples/research.py
STOCKMIND_TICKERS=NVDA
